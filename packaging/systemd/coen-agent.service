[Unit]
Description=Coen agent (private tunnel endpoint)
After=network-online.target
Wants=network-online.target

[Service]
# notify: the agent reports when it is ready, and `systemctl reload` replaces
# the agent process without a gap (a new process takes over as the main one).
Type=notify
ExecStart=/usr/bin/coen agent --config /etc/coen/agent.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
User=coen
Group=coen
RuntimeDirectory=coen
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/coen /run/coen

[Install]
WantedBy=multi-user.target
